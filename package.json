{
  "name": "home-workout-cg-maker",
  "private": true,
  "version": "11.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "bash restore-source.sh",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke": "node scripts/smoke.mjs",
    "preflight": "node scripts/preflight.mjs",
    "coverage": "node scripts/check-motion-coverage.mjs",
    "qa:test": "node scripts/test-qa-rules.mjs",
    "assets:test": "node scripts/validate-assets.mjs",
    "validate": "npm run smoke && npm run coverage && npm run qa:test && npm run assets:test && npm run candidates:test && npm run candidate-fetch:test && npm run approval:test && npm run device-sync:test && npm run certify:selftest && npm run vendor:selftest && npm run finish-dashboard:test && npm run local-api:test && npm run dashboard-certify:test && npm run portable:offline && npm run evidence:test && npm run dashboard-evidence:test && npm run evidence-watch:test && npm run evidence-recovery:test && npm run guided-gates:test",
    "setup:check": "node scripts/setup-check.mjs",
    "model:install": "node scripts/model-install.mjs",
    "release:check": "node scripts/release-check.mjs",
    "model:audit": "node scripts/model-audit.mjs",
    "model:drop": "node scripts/model-drop.mjs",
    "candidate:intake": "node scripts/candidate-intake.mjs",
    "candidate:receive": "node scripts/candidate-receive.mjs",
    "candidate:promote": "node scripts/candidate-promote.mjs",
    "candidates:test": "node scripts/validate-remote-candidates.mjs",
    "approval:test": "node scripts/test-approval-policy.mjs",
    "release:freeze": "node scripts/release-freeze.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "browser:diagnose": "node scripts/browser-diagnose.mjs",
    "release:all": "node scripts/release-all.mjs",
    "build:gate": "node scripts/build-gate.mjs",
    "portable:verify": "node scripts/portable-verify.mjs",
    "target:kit:test": "node scripts/target-kit-test.mjs",
    "final:readiness": "node scripts/final-readiness.mjs",
    "release:final": "npm run release:all && npm run final:readiness",
    "candidate:qa:kit": "node scripts/final-candidate-qa-kit.mjs",
    "candidate:finalize": "node scripts/candidate-finalize.mjs",
    "final:certify": "node scripts/final-certify.mjs",
    "final:status": "node scripts/final-status.mjs",
    "portable:offline": "node scripts/build-portable-offline.mjs",
    "device-sync:test": "node scripts/test-device-sync.mjs",
    "certify:selftest": "node scripts/test-final-certification.mjs",
    "portable:vendor": "node scripts/mirror-portable-vendor.mjs",
    "vendor:selftest": "node scripts/test-vendor-mirror.mjs",
    "candidate:fetch": "node scripts/fetch-remote-candidate.mjs",
    "candidate-fetch:test": "node scripts/test-candidate-fetch.mjs",
    "finish-dashboard:test": "node scripts/test-finish-dashboard.mjs",
    "local-api:test": "node scripts/test-local-api-router.mjs",
    "dashboard-certify:test": "node scripts/test-dashboard-certification.mjs",
    "evidence:import": "node scripts/evidence-import.mjs",
    "evidence:test": "node scripts/test-evidence-import.mjs",
    "dashboard-evidence:test": "node scripts/test-dashboard-evidence.mjs",
    "evidence-watch:test": "node scripts/test-evidence-watch.mjs",
    "evidence-recovery:test": "node scripts/test-evidence-recovery.mjs",
    "guided-gates:test": "node scripts/test-guided-gates.mjs",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.18.0",
    "three": "^0.172.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mediapipe/tasks-vision": "^1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
